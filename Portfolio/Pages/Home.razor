@page "/"

<div class="portfolio-container @(isDarkTheme ? "dark-theme" : "light-theme")">

    <!-- HERO -->

    <header class="hero-section">

        <div class="topbar">

            <div class="availability">

                <span class="status-dot"></span>

                Unity C# Developer

            </div>

            <div class="language-switcher" aria-label="Language selector">

                <button type="button"

                        class="language-btn @(!isRussian ? "active" : "")"

                        @onclick="() => SetLanguage(false)">

                    EN

                </button>

                <span>/</span>

                <button type="button"

                        class="language-btn @(isRussian ? "active" : "")"

                        @onclick="() => SetLanguage(true)">

                    RU

                </button>

                

            </div>

            

        </div>

        <div class="hero-content">

            <div class="hero-identity">

                <div>

                    <p class="eyebrow">UNITY / C# / GAME DEVELOPMENT</p>

                    <h1>NIKITA<br /><span>KOWALSKI</span></h1>

                </div>

                <img src="images/me.jpg" alt="Nikita Kowalski" class="profile-photo" />

            </div>

            <p class="hero-description">

                @T(

                    "Unity C# developer focused on gameplay systems, AI, architecture and practical game development.",

                    "Unity C# разработчик, сфокусированный на игровой логике, системах, ИИ, архитектуре и практической разработке игр."

                )

            </p>

            <div class="hero-actions">

                <a href="#projects" class="primary-btn">

                    @T("View Projects", "Смотреть проекты")

                </a>

                <a href="#contact" class="secondary-btn">

                    @T("Contact", "Связаться")

                </a>

            </div>

            <div class="quick-stats">

                <div>

                    <strong>6</strong>

                    <span>@T("Released Games", "Релизов игр")</span>

                </div>

                  <div>
                    <strong>UNITY 6</strong>
                    <span>6000.3.26f1 LTS / C#</span>
                </div>

                <div>

                    <strong>WINDOWS</strong>

                    <span>@T("Builds", "Сборки")</span>

                </div>

            </div>

        </div>

    </header>

    <!-- LINKS -->

    <section class="links-section">

        <div class="section-label">01 / LINKS</div>

        <h2>@T("Code, Projects & Profiles", "Код, проекты и профили")</h2>

        <div class="links-grid">

            <a href="https://github.com/1RETY1" target="_blank" class="link-card">

                <span class="link-title">GitHub</span>

                <span class="link-arrow">↗</span>

            </a>

            <a href="https://1rety1.itch.io/" target="_blank" class="link-card">

                <span class="link-title">Itch.io</span>

                <span class="link-meta">@T("6 released games", "6 опубликованных игр")</span>

                <span class="link-arrow">↗</span>

            </a>

            <a href="https://www.linkedin.com/in/nikita-kowalski-81585034b"

               target="_blank" class="link-card">

                <span class="link-title">LinkedIn</span>

                <span class="link-arrow">↗</span>

            </a>

            <a href="https://t.me/RETYGM" target="_blank" class="link-card">

                <span class="link-title">@T("Telegram Channel", "Telegram-канал")</span>

                <span class="link-arrow">↗</span>

            </a>

        </div>

        <div class="code-note">

            <span class="note-icon">↳</span>

            <div>

                <strong>@T("Private repositories", "Приватные репозитории")</strong>

                <p>

                    @T(

                        "Source code for key projects is kept private to protect assets. Access is available upon request for technical review.",

                        "Исходный код ключевых проектов находится в приватных репозиториях для защиты ассетов. Доступ к коду предоставляется по запросу для технического ревью."

                    )

                </p>

            </div>

        </div>

    </section>

    <!-- PROJECTS -->

    <section id="projects" class="projects-section">

        <div class="section-label">02 / PROJECTS</div>

        <h2>@T("Selected Projects", "Избранные проекты")</h2>

        <!-- OBSERVED -->

        <article class="featured-project">

            <div class="project-top">

                <div>

                    <span class="project-number">01</span>

                    <span class="project-status">

                        @T("RELEASED", "ОПУБЛИКОВАНА")

                    </span>

                </div>

                <span class="project-tech">UNITY / C# / 3D</span>

            </div>

            <div class="featured-content">

                <div class="featured-text">

                    <h3>OBSERVED</h3>

                    <p class="project-lead">

                        @T(

                            "Released 3D survival horror game focused on gameplay systems, custom state machines and system integration.",

                            "Опубликованная 3D survival horror игра, сфокусированная на игровой логике, конечных автоматах и интеграции систем."

                        )

                    </p>

                <div class="project-actions">

                    <a href="#" target="_blank" class="primary-btn project-play-btn">

                        @T("Play on Itch.io ↗", "Играть на Itch.io ↗")

                    </a>

                </div>

                    <div class="systems-grid">

                        <div class="system-card">

                            <span>01</span>

                            <h4>@T("AI & Navigation", "ИИ и навигация")</h4>

                            <p>

                                @T(

                                    "Custom enemy AI using NavMesh and line-of-sight detection for dynamic stalker behaviour.",

                                    "Кастомный ИИ противника на базе NavMesh и определения зоны видимости для динамического преследования."

                                )

                            </p>

                        </div>

                        <div class="system-card">

                            <span>02</span>

                            <h4>@T("Stealth & Hiding", "Скрытность и укрытия")</h4>

                            <p>

                                @T(

                                    "Interaction systems for hiding triggers, camera transitions and environmental occlusion.",

                                    "Системы взаимодействия с укрытиями, переключением камер и окклюзией окружения."

                                )

                            </p>

                        </div>

                        <div class="system-card">

                            <span>03</span>

                            <h4>@T("Event Architecture", "Событийная архитектура")</h4>

                            <p>

                                @T(

                                    "Event-driven systems for timed survival mechanics, dynamic audio zones and state persistence.",

                                    "Событийно-ориентированные системы для таймеров выживания, динамических аудиозон и сохранения состояний."

                                )

                            </p>

                        </div>

                        <div class="system-card">

                            <span>04</span>

                            <h4>@T("Code Structure", "Структура кода")</h4>

                            <p>

                                @T(

                                    "Modular C# project organization with OOP, clean component structure and custom inspector extensions.",

                                    "Модульная организация C# проекта с ООП, структурой компонентов и расширениями инспектора."

                                )

                            </p>

                        </div>

                    </div>

                </div>

                <div class="featured-media">

                    <div class="media-label">OBSERVED / RELEASED</div>

                    <div class="screenshots-grid">

                        <img src="images/obs1.jpg"

                             alt="Observed Screen 1"

                             class="portfolio-img zoomable"

                             @onclick='() => OpenImage("images/obs1.jpg")' />

                        <img src="images/obs2.jpg"

                             alt="Observed Screen 2"

                             class="portfolio-img zoomable"

                             @onclick='() => OpenImage("images/obs2.jpg")' />

                        <img src="images/obs3.jpg"

                             alt="Observed Screen 3"

                             class="portfolio-img zoomable"

                             @onclick='() => OpenImage("images/obs3.jpg")' />

                    </div>

                </div>

            </div>

        </article>

        <!-- RELEASED GAMES -->

        <article class="project-card">

            <div class="project-card-header">

                <div>

                    <span class="project-number">02</span>

                    <h3>@T("Released Games", "Опубликованные игры")</h3>

                </div>

                <span class="project-tech">ITCH.IO / 6 RELEASES</span>

            </div>

            <p class="project-description">

                @T(

                    "Designed, developed and released 6 game projects on Itch.io, ranging from 2D arcade platformers to 3D survival horror.",

                    "Спроектировал, разработал и выпустил 6 игровых проектов на Itch.io — от 2D-аркад и платформеров до 3D survival horror."

                )

            </p>

            <div class="release-highlight">

                <div>

                    <span class="small-label">@T("FEATURED RELEASE", "ВЫДЕЛЕННЫЙ РЕЛИЗ")</span>

                    <h4>Fast Jumper / Retro Restart</h4>

                    <p>

                        @T(

                            "2D arcade project with responsive controls and an optimized gameplay loop.",

                            "2D-аркада с отзывчивым управлением и оптимизированным игровым циклом."

                        )

                    </p>

                </div>

                <a href="https://1rety1.itch.io/" target="_blank" class="primary-btn">

                    @T("View Games ↗", "Смотреть игры ↗")

                </a>

            </div>

        </article>

    </section>

    <!-- TECHNICAL SKILLS -->

    <section class="skills-section">

        <div class="section-label">03 / SKILLS</div>

        <h2>@T("Technical Focus", "Технический профиль")</h2>

        <div class="skills-grid">

            <div class="skill-group">

                <span class="skill-index">01</span>

                <h3>Programming</h3>

                <div class="tags">

                    <span>C#</span>

                    <span>OOP</span>

                    <span>SOLID</span>

                    <span>Visual Studio</span>

                    <span>VS Code</span>

                </div>

            </div>

            <div class="skill-group">

                <span class="skill-index">02</span>

                <h3>Unity</h3>

                <div class="tags">

                    <span>Gameplay</span>

                    <span>AI</span>

                    <span>NavMesh</span>

                    <span>UI</span>

                    <span>Audio</span>

                </div>

            </div>

            <div class="skill-group">

                <span class="skill-index">03</span>

                <h3>Architecture</h3>

                <div class="tags">

                    <span>State Machines</span>

                    <span>Events</span>

                    <span>Modular Systems</span>

                </div>

            </div>

            <div class="skill-group">

                <span class="skill-index">04</span>

                <h3>Tools</h3>

                <div class="tags">

                    <span>GitHub</span>

                    <span>GitHub Desktop</span>

                    <span>Visual Studio</span>

                    <span>VS Code</span>

                    

                </div>

            </div>

        </div>

    </section>

    <!-- DEVELOPMENT ENVIRONMENT -->

    <section class="environment-section">

        <div class="section-label">04 / ENVIRONMENT</div>

        <h2>@T("Development Environment", "Среда разработки")</h2>

        <div class="environment-grid">

            <div class="environment-card">

                <span class="small-label">ENGINE</span>

                <h3>Unity 6 (6000.3.26f1 LTS)</h3>
                <p>@T("Main engine used for current game development. Previously worked with Unity 2022.3.14f1.", "Основной движок для текущей разработки. Ранее работал с Unity 2022.3.14f1.")</p>

            </div>

            <div class="environment-card">

                <span class="small-label">LANGUAGE</span>

                <h3>C#</h3>

                <p>@T("Primary programming language for Unity projects.", "Основной язык программирования для Unity-проектов.")</p>

            </div>

            <div class="environment-card">

                <span class="small-label">IDE / EDITORS</span>

                <h3>Visual Studio · VS Code</h3>

                <p>@T("Code is written using Visual Studio and Visual Studio Code.", "Для написания кода использую Visual Studio и Visual Studio Code.")</p>

            </div>

            <div class="environment-card">

                <span class="small-label">VERSION CONTROL</span>

                <h3>GitHub · GitHub Desktop</h3>

                <p>@T("Used for repositories and Git workflow.", "Использую для репозиториев и работы с Git.")</p>

            </div>

            <div class="environment-card">

                <span class="small-label">BUILD TARGET</span>

                <h3>Windows</h3>

                <p>@T("Windows builds are used for releases and testing.", "Использую Windows-сборки для релизов и тестирования проектов.")</p>

            </div>

        </div>

    </section>

    <!-- EDUCATION -->

    <section class="education-section">

        <div class="section-label">05 / EDUCATION</div>

        <h2>@T("Education & Training", "Образование и подготовка")</h2>

        <div class="education-grid">

            <div class="education-main">

                <span class="small-label">@T("HIGHER EDUCATION", "ВЫСШЕЕ ОБРАЗОВАНИЕ")</span>

                <h3>

                    @T(

                        "Yanka Kupala State University of Grodno",

                        "Гродненский государственный университет имени Янки Купалы"

                    )

                </h3>

                <p>

                    @T(

                        "Faculty of Physics and Technology — Computer Physics. Enrolled 2026.",

                        "Физико-технический факультет — специальность «Компьютерная физика». Поступление: 2026 г."

                    )

                </p>

            </div>

            <div class="education-main">

                <span class="small-label">@T("SOFTWARE ENGINEERING", "ПРОГРАММИРОВАНИЕ")</span>

                <h3>C# / Unity</h3>

                <p>

                    @T(

                        "C# and Unity development through self-study, practical project work and specialized courses at IT Academy Grodno.",

                        "Изучение C# и Unity через самообразование, практическую разработку проектов и специализированные курсы в IT Academy Grodno."

                    )

                </p>

            </div>

            <div class="education-main">

                <span class="small-label">@T("ADDITIONAL TRAINING", "ДОПОЛНИТЕЛЬНАЯ ПОДГОТОВКА")</span>

                <h3>Python — 1 year</h3>

                <p>

                    @T(

                        "One year of Python programming courses at IT Academy Grodno. Certificate included below.",

                        "Один год обучения программированию на Python в IT Academy Grodno. Сертификат представлен ниже."

                    )

                </p>

            </div>

        </div>

        <div class="certificates">

            <div class="certificate-item" @onclick='() => OpenImage("images/unity1.jpg")'>

                <img src="images/unity1.jpg" alt="Unity Game Development Certificate Part 1" />

                <span>UNITY / 01</span>

            </div>

            <div class="certificate-item" @onclick='() => OpenImage("images/unity2.jpg")'>

                <img src="images/unity2.jpg" alt="Unity Game Development Certificate Part 2" />

                <span>UNITY / 02</span>

            </div>

            <div class="certificate-item" @onclick='() => OpenImage("images/python1.jpg")'>

                <img src="images/python1.jpg" alt="Python Programming Certificate" />

                <span>PYTHON / 01</span>

            </div>

        </div>

    </section>

    <!-- CONTACT -->

    <section id="contact" class="contact-section">

        <div class="section-label">06 / CONTACT</div>

        <div class="contact-content">

            <div>

                <p class="eyebrow">@T("LET'S CONNECT", "БУДЕМ НА СВЯЗИ")</p>

                <h2>@T("Have a project or opportunity?", "Есть проект или предложение?")</h2>

            </div>

            <div class="contact-links">

                <a href="mailto:nika.koval08@mail.ru">nika.koval08@mail.ru ↗</a>

                <a href="tel:+375333016869">+375 (33) 301-68-69 ↗</a>

                <a href="https://t.me/Kowal_Nik" target="_blank">@@Kowal_Nik ↗</a>

                <a href="https://github.com/1RETY1" target="_blank">GitHub ↗</a>

            </div>

        </div>

    </section>

    <!-- LIGHTBOX -->

    @if (isLightboxOpen)

    {

        <div class="lightbox-overlay" @onclick="CloseImage">

            <div class="lightbox-content" @onclick:stopPropagation>

                <button class="lightbox-close" @onclick="CloseImage">&times;</button>

                <img src="@activeImageUrl" class="lightbox-image" />

            </div>

        </div>

    }

</div>

@code {

    private bool isLightboxOpen = false;

    private string activeImageUrl = "";

    private bool isRussian = false;

    private bool isDarkTheme = true;

    private string T(string english, string russian)

        => isRussian ? russian : english;

    private void SetLanguage(bool russian)

    {

        isRussian = russian;

    }

    private void ToggleTheme()

    {

        isDarkTheme = !isDarkTheme;

    }

    private void OpenImage(string url)

    {

        activeImageUrl = url;

        isLightboxOpen = true;

    }

    private void CloseImage()

    {

        isLightboxOpen = false;

    }

}

<style>

    :root {

        --bg: #090a0d;

        --surface: #111318;

        --surface-2: #171a21;

        --border: #272c36;

        --text: #f2f4f7;

        --muted: #8b94a3;

        --accent: #00ff66;

        --accent-dark: #00c94f;

        --max-width: 1120px;

    }

    * {

        box-sizing: border-box;

    }

    html {

        scroll-behavior: smooth;

    }

    body {

        margin: 0;

        background: var(--bg);

        color: var(--text);

        font-family: "Segoe UI", Roboto, Helvetica, Arial, sans-serif;

    }

    a {

        color: inherit;

    }

    .portfolio-container {

        width: min(var(--max-width), calc(100% - 40px));

        margin: 0 auto;

        padding: 24px 0 80px;

    }

    .hero-section {

        min-height: 650px;

        padding: 28px 34px 34px;

        border: 1px solid var(--border);

        border-radius: 18px;

        background:

            radial-gradient(circle at 80% 10%, rgba(0, 255, 102, 0.09), transparent 28%),

            radial-gradient(circle at 10% 20%, #172034 0%, var(--bg) 58%);

        display: flex;

        flex-direction: column;

        justify-content: space-between;

        overflow: hidden;

        position: relative;

    }

    .hero-section::after {

        content: "UNITY / C#";

        position: absolute;

        right: -20px;

        bottom: 50px;

        font-size: clamp(5rem, 13vw, 10rem);

        font-weight: 900;

        letter-spacing: -8px;

        color: rgba(255, 255, 255, 0.025);

        pointer-events: none;

    }

    .topbar {

        display: flex;

        justify-content: space-between;

        align-items: center;

        position: relative;

        z-index: 2;

    }



    .theme-btn {

        width: 30px;

        height: 30px;

        margin-left: 4px;

        border: 1px solid var(--border);

        border-radius: 50%;

        background: var(--surface);

        color: var(--text);

        cursor: pointer;

        font-size: 0.9rem;

    }

    .theme-btn:hover {

        border-color: var(--accent);

        color: var(--accent);

    }

    .hero-identity {

        display: flex;

        align-items: flex-end;

        justify-content: space-between;

        gap: 35px;

    }

    .profile-photo {

        width: 185px;

        height: 185px;

        object-fit: cover;

        flex-shrink: 0;

        aspect-ratio: 1 / 1;

        border-radius: 50%;

        border: 2px solid var(--accent);

        box-shadow: 0 0 35px rgba(0, 255, 102, 0.12);

    }

    .environment-grid {

        display: grid;

        grid-template-columns: repeat(2, 1fr);

        gap: 12px;

    }

    .environment-card {

        padding: 22px;

        border: 1px solid var(--border);

        border-radius: 10px;

        background: var(--surface);

    }

    .environment-card h3 {

        margin: 10px 0 7px;

        font-size: 1.05rem;

    }

    .environment-card p {

        margin: 0;

        color: var(--muted);

        line-height: 1.5;

        font-size: 0.85rem;

    }

    .light-theme {

        --bg: #f2f4f6;

        --surface: #ffffff;

        --surface-2: #eef1f3;

        --border: #d8dde3;

        --text: #15181d;

        --muted: #606a76;

        --accent: #00a844;

        --accent-dark: #008b38;

    }

    .light-theme .hero-section {

        background:

            radial-gradient(circle at 80% 10%, rgba(0, 168, 68, 0.10), transparent 28%),

            radial-gradient(circle at 10% 20%, #dfe8e2 0%, var(--bg) 58%);

    }

    .light-theme .featured-media {

        background: #e9ecef;

    }

    .light-theme .hero-section::after {

        color: rgba(0, 0, 0, 0.035);

    }

    .light-theme .language-switcher {

        background: rgba(255,255,255,0.75);

    }

    .availability {

        display: flex;

        align-items: center;

        gap: 9px;

        color: var(--muted);

        font-size: 0.8rem;

        text-transform: uppercase;

        letter-spacing: 1.2px;

        font-weight: 700;

    }

    .status-dot {

        width: 8px;

        height: 8px;

        background: var(--accent);

        border-radius: 50%;

        box-shadow: 0 0 12px rgba(0, 255, 102, 0.7);

    }

    .language-switcher {

        display: inline-flex;

        align-items: center;

        gap: 7px;

        padding: 5px 8px;

        border: 1px solid var(--border);

        border-radius: 999px;

        background: rgba(9, 10, 13, 0.7);

    }

    .language-btn {

        border: 0;

        background: transparent;

        color: var(--muted);

        padding: 5px 8px;

        border-radius: 999px;

        cursor: pointer;

        font-weight: 800;

        font-size: 0.75rem;

    }

    .language-btn:hover,

    .language-btn.active {

        color: #000;

        background: var(--accent);

    }

    .hero-content {

        max-width: 850px;

        position: relative;

        z-index: 1;

        margin-top: auto;

        padding-top: 110px;

    }

    .eyebrow,

    .section-label,

    .small-label,

    .media-label {

        color: var(--accent);

        font-size: 0.72rem;

        font-weight: 800;

        letter-spacing: 1.7px;

        text-transform: uppercase;

    }

    .hero-content h1 {

        font-size: clamp(4rem, 10vw, 8.5rem);

        line-height: 0.82;

        letter-spacing: -6px;

        margin: 18px 0 28px;

        font-weight: 900;

    }

    .hero-content h1 span {

        color: transparent;

        -webkit-text-stroke: 1px #697180;

    }

    .hero-description {

        max-width: 650px;

        color: #aeb6c2;

        font-size: 1.15rem;

        line-height: 1.65;

    }

    .hero-actions {

        display: flex;

        flex-wrap: wrap;

        gap: 12px;

        margin-top: 28px;

    }

    .primary-btn,

    .secondary-btn {

        display: inline-flex;

        align-items: center;

        justify-content: center;

        padding: 12px 18px;

        border-radius: 7px;

        text-decoration: none;

        font-weight: 800;

        transition: 0.2s ease;

    }

    .primary-btn {

        background: var(--accent);

        color: #000;

    }

    .primary-btn:hover {

        background: var(--accent-dark);

        transform: translateY(-2px);

    }

    .secondary-btn {

        border: 1px solid var(--border);

        background: var(--surface);

    }

    .secondary-btn:hover {

        border-color: var(--accent);

